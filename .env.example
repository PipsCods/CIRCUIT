# Copy to .env and fill in. .env is gitignored.
#
# Values here take precedence over anything exported in your shell — a stray
# ANTHROPIC_* export must never silently redirect billed traffic mid-experiment.

# Gemma 4 (google/gemma-4-26b-a4b-it)
OPENROUTER_API_KEY=sk-or-v1-...

# Claude Sonnet 4.6 and optional Claude Fable 5, called through the official
# Anthropic SDK
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Only read from .env, never inherited from the shell.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
